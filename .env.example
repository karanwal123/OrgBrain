# Copy this file to backend/.env and fill in your values.
# Place your GCP service account JSON at backend/secrets/key.json

# Google Cloud / Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=./secrets/key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Optional integrations
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
ALLOWED_ORIGINS=*

# Slack (create app: docs/SLACK_APP_SETUP.md)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret
EXTRACTION_CONFIDENCE_THRESHOLD=0.3

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=org_brain
MONGODB_PROFILES_COLLECTION=employee_profiles

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=skill_embeddings
EMBEDDING_DIMENSION=768

# Application
APP_ENV=development
LOG_LEVEL=INFO
