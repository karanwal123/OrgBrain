# Copy this file to backend/.env and fill in your values.
# Place your GCP service account JSON at backend/secrets/key.json

# Google Cloud / Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=./secrets/key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Optional integrations
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
ALLOWED_ORIGINS=*

# Slack (create app: docs/SLACK_APP_SETUP.md)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret
EXTRACTION_CONFIDENCE_THRESHOLD=0.3

# MongoDB (Atlas recommended for Cloud Run)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=org_brain
MONGODB_PROFILES_COLLECTION=employee_profiles
MONGODB_MEMORY_COLLECTION=channel_memory

# Redis (Upstash recommended for Cloud Run — serverless, HTTPS-friendly)
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR-ENDPOINT.upstash.io:6379
REDIS_MEMORY_PREFIX=org_brain:memory
REDIS_CACHE_TTL_SECONDS=900

# Qdrant (Qdrant Cloud — set URL + API key; leave host/port for local Docker)
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=skill_embeddings
QDRANT_MEMORY_COLLECTION=channel_memory_embeddings
EMBEDDING_DIMENSION=768
EMBEDDING_MODEL_NAME=text-embedding-004

# Memory worker
MEMORY_SUMMARY_INTERVAL_MINUTES=20
MEMORY_RETRIEVAL_LIMIT=10

# --- Local dev only (comment out cloud URLs above and use these instead) ---
# MONGODB_URI=mongodb://localhost:27017
# REDIS_URL=redis://localhost:6379/0
# QDRANT_URL=
# QDRANT_API_KEY=

# Application
APP_ENV=development
LOG_LEVEL=INFO
